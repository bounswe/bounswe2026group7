# Copy this file to .env.production and fill in real values.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d

# ---- Database (DigitalOcean Managed PostgreSQL) ----
# Full JDBC connection string from DigitalOcean dashboard
# Format: jdbc:postgresql://<host>:<port>/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:25060/<db-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>

# ---- Backend ----
BACKEND_PORT=8080
# REQUIRED — generate with: openssl rand -base64 64
JWT_SECRET=<generate-a-strong-secret>
# Token expiration in milliseconds (default: 1 day)
JWT_EXPIRATION=86400000

# ---- URLs ----
# Backend base URL (used in verification email links)
APP_BASE_URL=https://your-domain.com
# Frontend URL (used in password reset email links)
APP_FRONTEND_URL=https://your-domain.com
# Comma-separated allowed CORS origins
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---- Mail (real SMTP) ----
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
APP_MAIL_FROM=noreply@your-domain.com

# ---- Email Verification ----
VERIFICATION_TOKEN_EXPIRY_HOURS=24
VERIFICATION_RESEND_MAX_PER_HOUR=3

# ---- Password Reset ----
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5

# ---- Frontend ----
FRONTEND_PORT=80
VITE_BACKEND_URL=https://your-domain.com/api
