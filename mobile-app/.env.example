# Copy this file to .env and set values before running the app.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.

# URL of the backend API server (without trailing slash, without /api).
# Examples:
#   Local dev (Android emulator): http://10.0.2.2:8080
#   Local dev (physical device):  http://<your-machine-ip>:8080
#   Production:                   http://<server-ip-or-domain>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
