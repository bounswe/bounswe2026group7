# Web Push (#447 / backend #136). Copy to .env.local and fill in from the
# Firebase project console (same project mobile registers against — see
# mobile-app/google-services.json for the bundled mobile config). Leaving
# these blank disables web push gracefully: the SW registers but stays
# inert, no permission prompt fires, no token is POSTed to the backend.
#
# VITE_FIREBASE_VAPID_KEY is the Web Push certificate from
#   Firebase Console → Project Settings → Cloud Messaging →
#   "Web push certificates" → Key pair.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
